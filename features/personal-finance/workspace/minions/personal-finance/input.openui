Card(children: [
  CardHeader(title: "Preview a local financial entry", subtitle: "No ledger write until you inspect Dashboard and explicitly confirm the exact posting."),
  Form(name: "minionInput", fields: [
    FormControl(label: "Date (YYYY-MM-DD)", input: Input(name: "date", rules: {required: true})),
    FormControl(label: "Description", input: Input(name: "description", rules: {required: true})),
    FormControl(label: "Amount (positive decimal)", input: Input(name: "amount", rules: {required: true})),
    FormControl(label: "Commodity (e.g. USD)", input: Input(name: "commodity", rules: {required: true})),
    FormControl(label: "Debit account", input: Input(name: "debit_account", placeholder: "expenses:groceries", rules: {required: true})),
    FormControl(label: "Credit account", input: Input(name: "credit_account", placeholder: "assets:checking", rules: {required: true})),
    FormControl(label: "Source URI (optional)", input: Input(name: "source_ref", placeholder: "openlia://source/…"))
  ], buttons: Buttons(buttons: [Button(label: "Validate & Preview", variant: "primary")]))
])
