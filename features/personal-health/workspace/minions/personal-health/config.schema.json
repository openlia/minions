{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal Health Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["trigger"],
  "properties": {
    "data_views": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "briefing": {"type": "array", "items": {"type": "string", "enum": ["follow-ups"]}, "uniqueItems": true, "default": []},
        "scopes": {"type": "object", "additionalProperties": {"type": "object"}, "default": {}}
      },
      "default": {"briefing": [], "scopes": {}}
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_new_entry": {"type": "boolean", "default": false},
        "cron": {"type": "string", "minLength": 1}
      },
      "default": {"on_new_entry": false}
    }
  }
}
