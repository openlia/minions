Card(children: [
  CardHeader(title: "Record a person-scoped health fact", subtitle: "Create a profile first. Never infer the subject or a diagnosis. Source files remain in the Vault."),
  Form(name: "minionInput", fields: [
    FormControl(label: "Record type", input: Select(name: "record_type", items: [SelectItem(value: "profile", label: "Profile"), SelectItem(value: "encounter", label: "Encounter"), SelectItem(value: "condition", label: "Condition"), SelectItem(value: "treatment", label: "Treatment"), SelectItem(value: "measurement", label: "Measurement")])),
    FormControl(label: "Person ID (required, stable identifier)", input: Input(name: "person_id", rules: {required: true})),
    FormControl(label: "Title / profile display name / measurement name", input: Input(name: "title", rules: {required: true})),
    FormControl(label: "Relationship (profiles only)", input: Select(name: "relationship_to_user", items: [SelectItem(value: "self", label: "Self"), SelectItem(value: "child", label: "Child"), SelectItem(value: "spouse", label: "Spouse"), SelectItem(value: "partner", label: "Partner"), SelectItem(value: "parent", label: "Parent"), SelectItem(value: "sibling", label: "Sibling"), SelectItem(value: "other-family", label: "Other family"), SelectItem(value: "other", label: "Other")])),
    FormControl(label: "Event date (encounter/measurement required; YYYY, YYYY-MM, YYYY-MM-DD or zoned timestamp)", input: Input(name: "event_date")),
    FormControl(label: "Source basis", input: Select(name: "source_type", items: [SelectItem(value: "user-report", label: "User report"), SelectItem(value: "clinician", label: "Clinician"), SelectItem(value: "lab-report", label: "Lab report"), SelectItem(value: "device", label: "Device"), SelectItem(value: "prescription", label: "Prescription"), SelectItem(value: "imported-record", label: "Imported record")])),
    FormControl(label: "Source URI", input: Input(name: "source_ref", placeholder: "openlia://source/…")),
    FormControl(label: "Condition verification", input: Select(name: "verification_status", items: [SelectItem(value: "reported", label: "Reported"), SelectItem(value: "unconfirmed", label: "Unconfirmed"), SelectItem(value: "confirmed", label: "Clinician confirmed"), SelectItem(value: "unknown", label: "Unknown")])),
    FormControl(label: "Condition kind", input: Select(name: "condition_kind", items: [SelectItem(value: "other", label: "Other / unspecified"), SelectItem(value: "diagnosis", label: "Diagnosis (verification tracked separately)"), SelectItem(value: "allergy", label: "Allergy"), SelectItem(value: "intolerance", label: "Intolerance"), SelectItem(value: "risk-factor", label: "Risk factor"), SelectItem(value: "family-history", label: "Family history")])),
    FormControl(label: "Family member relation (family history only)", input: Input(name: "family_member_relation")),
    FormControl(label: "Condition clinical status", input: Select(name: "clinical_status", items: [SelectItem(value: "unknown", label: "Unknown"), SelectItem(value: "active", label: "Active"), SelectItem(value: "resolved", label: "Resolved"), SelectItem(value: "inactive", label: "Inactive")])),
    FormControl(label: "Treatment status", input: Select(name: "treatment_status", items: [SelectItem(value: "unknown", label: "Unknown"), SelectItem(value: "planned", label: "Planned"), SelectItem(value: "active", label: "Active"), SelectItem(value: "completed", label: "Completed"), SelectItem(value: "stopped", label: "Stopped")])),
    FormControl(label: "Treatment kind", input: Select(name: "treatment_kind", items: [SelectItem(value: "other", label: "Other / unspecified"), SelectItem(value: "medication", label: "Medication"), SelectItem(value: "therapy", label: "Therapy"), SelectItem(value: "procedure", label: "Procedure"), SelectItem(value: "lifestyle", label: "Lifestyle")])),
    FormControl(label: "Treatment intent", input: Select(name: "treatment_intent", items: [SelectItem(value: "reported-use", label: "Reported use"), SelectItem(value: "prescribed", label: "Prescribed"), SelectItem(value: "recommended", label: "Recommended"), SelectItem(value: "unknown", label: "Unknown")])),
    FormControl(label: "Measurement value", input: Input(name: "value")),
    FormControl(label: "Measurement unit", input: Input(name: "unit")),
    FormControl(label: "Notes (facts only)", input: Input(name: "notes"))
  ], buttons: Buttons(buttons: [Button(label: "Save health record", variant: "primary")]))
])
