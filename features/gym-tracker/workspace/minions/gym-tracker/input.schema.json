{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gym Tracker Input Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item"
  ],
  "properties": {
    "date": {
      "type": "string",
      "title": "Date",
      "description": "ISO date YYYY-MM-DD (defaults to today)"
    },
    "item": {
      "type": "string",
      "minLength": 1,
      "title": "Exercise / Session",
      "description": "Exercise and set/rep summary"
    },
    "category": {
      "type": "string",
      "title": "Focus / Split",
      "enum": [
        "strength",
        "hypertrophy",
        "conditioning",
        "mobility",
        "general"
      ],
      "default": "strength"
    },
    "value": {
      "type": [
        "number",
        "string"
      ],
      "title": "Top Load / Metric",
      "description": "Primary load or numeric session metric"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "completed",
        "planned"
      ],
      "default": "completed"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "description": "Optional RPE or session observations"
    }
  }
}
