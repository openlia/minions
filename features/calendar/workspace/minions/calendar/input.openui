Card(children: [
  CardHeader(title: "Propose a local appointment", subtitle: "Preview first; inspect Dashboard and confirm the exact Remind entry with SAVE."),
  Form(name: "minionInput", fields: [
    FormControl(label: "Title", input: Input(name: "title", rules: {required: true})),
    FormControl(label: "Start (ISO-8601 with offset)", input: Input(name: "start", placeholder: "2026-10-15T10:00:00-04:00", rules: {required: true})),
    FormControl(label: "End (ISO-8601 with offset)", input: Input(name: "end", placeholder: "2026-10-15T11:00:00-04:00", rules: {required: true})),
    FormControl(label: "IANA timezone", input: Input(name: "timezone", placeholder: "America/New_York", rules: {required: true})),
    FormControl(label: "Agenda / event note (optional)", input: Input(name: "agenda", placeholder: "Creates a companion note when supplied")),
    FormControl(label: "Attendees (comma-separated)", input: Input(name: "attendees")),
    FormControl(label: "Location", input: Input(name: "location")),
    FormControl(label: "Video link", input: Input(name: "video_link")),
    FormControl(label: "Tags (comma-separated)", input: Input(name: "tags", placeholder: "meeting, client"))
  ], buttons: Buttons(buttons: [Button(label: "Validate & Preview", variant: "primary")]))
])
