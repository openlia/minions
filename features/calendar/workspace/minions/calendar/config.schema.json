{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calendar Minion Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["trigger", "calendar_file", "timezone"],
  "properties": {
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_new_entry": {"type": "boolean", "default": false},
        "cron": {"type": "string", "minLength": 1}
      },
      "default": {"on_new_entry": false}
    },
    "calendar_file": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.(?:rem|remind)$",
      "default": "reminders.rem",
      "description": "Literal Remind source relative to this app's data directory."
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*$",
      "default": "UTC",
      "description": "Default IANA timezone for new appointments."
    }
  }
}
